TRAVELINGHUB_ENV=development
TRAVELINGHUB_HTTP_ADDR=:8080
TRAVELINGHUB_POSTGRES_DSN=postgres://travelinghub:travelinghub@postgres:5432/travelinghub?sslmode=disable
TRAVELINGHUB_REDIS_ADDR=redis:6379
TRAVELINGHUB_AUTO_MIGRATE=true
TRAVELINGHUB_BUILD_VERSION=dev
TRAVELINGHUB_SESSION_TTL=168h
TRAVELINGHUB_AUTO_VERIFY_EMAIL=true
TRAVELINGHUB_WEB_ORIGIN=http://localhost:5173
TRAVELINGHUB_SMTP_ADDR=
TRAVELINGHUB_SMTP_FROM=
TRAVELINGHUB_SMTP_USERNAME=
TRAVELINGHUB_SMTP_PASSWORD=
TRAVELINGHUB_JOURNEY_WORKER_INTERVAL=1m
TRAVELINGHUB_JOURNEY_WORKER_BATCH=100
